{
  "name": "@achiral/cli",
  "version": "0.1.0",
  "description": "Developer CLI for Achiral – connect to your organisation's AI model engine",
  "type": "module",
  "bin": {
    "achiral": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outfile dist/index.js --target node --sourcemap",
    "build:prod": "bun build src/index.ts --outfile dist/index.js --target node --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^12.1.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
