{
  "name": "@achiral/cli",
  "version": "0.1.1",
  "description": "Developer CLI for Achiral – connect to your organisation's AI model engine",
  "type": "module",
  "license": "UNLICENSED",
  "homepage": "https://achiral.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Achiral-AI/achiral.cli.git"
  },
  "bugs": {
    "url": "https://github.com/Achiral-AI/achiral.cli/issues"
  },
  "keywords": [
    "achiral",
    "ai",
    "cli",
    "assistant",
    "agent",
    "chiro",
    "memory"
  ],
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "README.md"
  ],
  "bin": {
    "achiral": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outfile dist/index.js --target node --sourcemap",
    "build:prod": "bun build src/index.ts --outfile dist/index.js --target node --minify",
    "prepack": "bun run build",
    "pack:dry": "npm pack --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^12.1.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
